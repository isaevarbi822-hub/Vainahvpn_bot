{
  "name": "vainah-vpn-desktop-preview",
  "version": "0.2.0",
  "private": true,
  "description": "Vainah VPN Windows & macOS interface preview — no active VPN tunnel",
  "author": "Vainah VPN",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "sync:site": "node scripts/sync-site.cjs",
    "prestart": "npm run sync:site",
    "predist:win": "npm run sync:site",
    "predist:mac": "npm run sync:site"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.vainah.vpn.desktop",
    "productName": "Vainah VPN",
    "asar": true,
    "files": [
      "src/**/*",
      "ui/**/*",
      "shared/**/*",
      "package.json",
      "site-mirror/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VainahVPN-Windows-UI-Preview-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "VainahVPN-macOS-UI-Preview-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": null
  }
}
