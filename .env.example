# Пример — НЕ хранить настоящие ключи в GitHub
ROLLYPAY_TERMINAL_ID=your-terminal-id
ROLLYPAY_API_KEY=your-api-key
ROLLYPAY_SIGNING_SECRET=your-webhook-signing-secret
ROLLYPAY_TEST_TOKEN=

# --- Future standalone website checkout: set secrets ONLY in Netlify ---
# Canonical HTTPS origin WITHOUT a trailing slash, e.g. https://example.netlify.app
PUBLIC_SITE_ORIGIN=
# From @BotFather: owner-controlled bot token (NEVER commit real token)
TELEGRAM_BOT_TOKEN=
# Generate a unique random secret at least 32 characters long
SESSION_SIGNING_KEY=
# PostgreSQL transaction database. Run database/subscriptions.sql first.
DATABASE_URL=
# Prices are RUB strings, set real agreed values; never display guessed prices
VAINAH_PRICE_30_RUB=
VAINAH_PRICE_90_RUB=
VAINAH_PRICE_365_RUB=
# Your H1Cloud VPN PANEL URL and panel API token (not account-level h1_ token)
PANEL_BASE_URL=
PANEL_API_TOKEN=
PANEL_INBOUND_IDS=
PANEL_CLIENT_PREFIX=tg_
# Must verify existing bot H1Cloud naming/mapping, then explicitly set true
PANEL_CLIENT_MAPPING_VERIFIED=false
# OFF until integration reviewed, tested, deployed, and webhook configured
VAINAH_LIVE_CHECKOUT=disabled
