# Vainah VPN -- server-side Netlify environment template, never commit real secrets!
# Replace placeholders privately in Netlify Site configuration / Environment variables.
PUBLIC_SITE_ORIGIN=https://your-site.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
SESSION_SIGNING_KEY=generate-a-strong-random-secret-of-at-least-32-characters
TELEGRAM_BOT_TOKEN=your-telegram-login-bot-token
PANEL_BASE_URL=https://your-h1cloud-panel.example
PANEL_API_TOKEN=your-h1cloud-private-api-token
PANEL_CLIENT_PREFIX=tg
# New Telegram OIDC login (from BotFather > Login Widget).
# These are NOT the Telegram bot token; keep the secret server-side.
TELEGRAM_OIDC_CLIENT_ID=123456789
TELEGRAM_OIDC_CLIENT_SECRET=your-oidc-client-secret-from-botfather
# Register https://your-site.example/auth/telegram/callback in BotFather Allowed URLs
# Optional H1Cloud settings
PANEL_INBOUND_IDS=
TRAFFIC_LIMIT_GB=0

ROLLYPAY_API_KEY=your-rollypay-private-api-key
ROLLYPAY_SIGNING_SECRET=your-private-rollypay-callback-secret
# Optional when bound by API key; specify if your RollyPay terminal requires it.
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_TEST_TOKEN=generate-a-separate-private-admin-password-24-plus-chars

# Default: live charges OFF. Enable ONLY after the checklist in PAYMENTS-LIVE-ROLLOUT.md.
VAINAH_LIVE_CHECKOUT=disabled
VAINAH_PAYMENT_INTEGRATION_VERIFIED=not-verified
